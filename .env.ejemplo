# =====================================================================
# SERVI-RED · Variables de entorno
# Copiar a .env (cp .env.ejemplo .env) y reemplazar los valores.
# .env está en .gitignore: NUNCA versionar secretos reales.
# =====================================================================

# --- Base de datos (solo la usa el servicio persistencia) -------------
# Por defecto apunta al PostgreSQL local del compose.
# Para usar Supabase: copiar la cadena "Session pooler" del proyecto
# (Project Settings > Database) en formato JDBC, p. ej.:
#   jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
PERSISTENCIA_DB_URL=jdbc:postgresql://postgres-local:5432/servired
PERSISTENCIA_DB_USUARIO=servired
PERSISTENCIA_DB_CLAVE=cambiar-clave-db

# Credenciales del PostgreSQL local (solo desarrollo)
POSTGRES_LOCAL_USUARIO=servired
POSTGRES_LOCAL_CLAVE=cambiar-clave-db

# --- Almacén de evidencias (solo persistencia) -------------------------
# Por defecto: SeaweedFS local del compose (S3 compatible).
# Para Supabase Storage (Project Settings > Storage > S3 Connection):
#   ALMACEN_S3_URL=https://tu-proyecto.supabase.co/storage/v1/s3
#   ALMACEN_S3_REGION=<región del proyecto>   ALMACEN_S3_ACCESO / ALMACEN_S3_SECRETO = claves S3
#   ALMACEN_S3_CREAR_BUCKET=false             (cree el bucket privado desde el panel)
ALMACEN_S3_URL=http://almacen:8333
ALMACEN_S3_REGION=us-east-1
ALMACEN_S3_ACCESO=servired-almacen
ALMACEN_S3_SECRETO=cambiar-secreto-almacen
ALMACEN_S3_BUCKET=evidencias
ALMACEN_S3_CREAR_BUCKET=true

# --- RabbitMQ ---------------------------------------------------------
RABBITMQ_USUARIO=servired
RABBITMQ_CLAVE=cambiar-clave-rabbit

# --- Credenciales internas hacia persistencia (una por servicio) -----
# Persistencia solo permite a cada servicio las operaciones de su dominio.
PERSISTENCIA_CLAVE_IDENTIDAD=cambiar-clave-identidad
PERSISTENCIA_CLAVE_REPORTES=cambiar-clave-reportes
PERSISTENCIA_CLAVE_ATENCION=cambiar-clave-atencion
PERSISTENCIA_CLAVE_INDICADORES=cambiar-clave-indicadores
PERSISTENCIA_CLAVE_AUDITORIA=cambiar-clave-auditoria

# --- Identidad (fase 3) -----------------------------------------------
# Clave RSA con la que Identidad firma los JWT: PKCS#8 DER en Base64, en una
# sola línea. Generarla con:  sh infra/generar-clave-jwt.sh
# Si se deja vacía se usa una clave efímera (los tokens mueren al reiniciar).
IDENTIDAD_JWT_CLAVE_PRIVADA=
# Primer administrador; se crea al arrancar si no existe. Cambie la clave.
IDENTIDAD_ADMIN_CORREO=admin@servired.local
IDENTIDAD_ADMIN_CLAVE=cambiar-clave-admin

# --- Auditoría y alertas (fase 7) -------------------------------------
# Token compartido entre Alertmanager y el webhook interno de Auditoría (mín. 16).
ALERTAS_TOKEN=cambiar-token-alertas
# Perfil opcional de observabilidad (Prometheus, Alertmanager, Grafana, Jaeger).
GRAFANA_CLAVE=cambiar-clave-grafana
# true para exportar trazas a Jaeger (usar con --profile observabilidad).
TRAZAS_ACTIVAS=false

# --- Anclas de la cadena de auditoría (ADR-31) -------------------------------
# Cada día se publica el último hash de la cadena en un archivo de GitHub (rama
# anclas-auditoria), fuera del control del sistema. Token de grano fino con
# «Contents: Read and write» SOLO sobre ese repositorio. Vacío = solo en la base y
# en la API pública (GET /api/v1/auditoria/anclas).
AUDITORIA_ANCLAS_GITHUB_REPOSITORIO=
AUDITORIA_ANCLAS_GITHUB_TOKEN=
